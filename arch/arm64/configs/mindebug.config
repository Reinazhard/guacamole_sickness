# === Baseline ===
CONFIG_PREEMPT=y
CONFIG_DEBUG_PREEMPT=y
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_RCU=y
CONFIG_PROVE_RCU_LIST=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_SECTION_MISMATCH=y
CONFIG_SECTION_MISMATCH_WARN_ONLY=y

# === Locking ===
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_LOCKDEP=y
CONFIG_LOCK_STAT=y

# === Memory safety & Sanitizers ===
CONFIG_KASAN=y
CONFIG_KASAN_SW_TAGS=y
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_STACK=y
CONFIG_KASAN_VMALLOC=y
##CONFIG_KFENCE=y

# === Concurrency ===
##CONFIG_KCSAN=y
##CONFIG_KCSAN_STRICT=y

# === Undefined behavior ===
##CONFIG_UBSAN=y
##CONFIG_UBSAN_BOUNDS=y
##CONFIG_UBSAN_SHIFT=y
##CONFIG_UBSAN_INTEGER_OVERFLOW=y
##CONFIG_UBSAN_BOOL=y
##CONFIG_UBSAN_ENUM=y
##CONFIG_UBSAN_UNREACHABLE=y
##CONFIG_UBSAN_ALIGNMEN=y
##CONFIG_UBSAN_DIV_ZERO=y
### CONFIG_UBSAN_TRAP is not set

# === Object lifetime / leaks ===
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
# CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF is not set

# === Stack protection ===
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# === Symbolication & Debug Info ===
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=y
CONFIG_DEBUG_INFO_COMPRESSED=y
CONFIG_DEBUG_INFO_SPLIT=y
CONFIG_DEBUG_INFO_DWARF5=y
##CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_FRAME_POINTER=y
CONFIG_FRAME_WARN=2048

# === Coverage (for fuzzing integration) ===
# CONFIG_KCOV is not set
# CONFIG_KCOV_INSTRUMENT_ALL is not set

# === printk and dmesg options ===
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_PRINTK_CALLER=y
CONFIG_PRINTK_TIME=y

# === Memory Debugging & VM ===
CONFIG_PAGE_EXTENSION=y
CONFIG_PAGE_OWNER=y
CONFIG_DEBUG_OBJECTS_ENABLE_DEFAULT=1
CONFIG_DEBUG_OBJECTS_PERCPU_COUNTER=y
CONFIG_DEBUG_PER_CPU_MAPS=y
CONFIG_DEBUG_STACK_USAGE=y
CONFIG_DEBUG_VIRTUAL=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_VM_PGFLAGS=y
CONFIG_DEBUG_VM_RB=y
CONFIG_DEBUG_VM_VMACACHE=y
CONFIG_GENERIC_PTDUMP=y
CONFIG_PTDUMP_DEBUGFS=y
# CONFIG_DEBUG_RODATA_TEST is not set
# CONFIG_DEBUG_WX is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_SLUB_STATS is not set

# === Debug Oops, Lockups and Hangs ===
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=0
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set

# === Tracers & Profiling ===
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_BRANCH_PROFILE_NONE=y

# === Override main defconfig ===
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_DEBUG_KERNEL=y
# CONFIG_ANDROID_ONLY_VH_TRACING is not set
# CONFIG_LTO_GCC is not set
# CONFIG_WARN_ALL_UNSEEDED_RANDOM is not set
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3 is not set
##CONFIG_CC_OPTIMIZE_FOR_SIZE=y
